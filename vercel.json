{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, max-age=0" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/share/:id",
      "destination": "/api/share?id=:id"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp|facebookexternalhit|TelegramBot|Twitterbot|LinkedInBot).*"
        }
      ],
      "destination": "/api/og"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
